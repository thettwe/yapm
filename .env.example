# yapm environment — copy to .env and edit. Every value below has a working
# default baked into the compose files, so `docker compose -f docker/docker-compose.yml up -d`
# runs with an empty .env for a localhost deploy. Override what you need for production.
#
# Compose reads .env from the directory you run it in. Run compose from the repo root:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
# (or `cp .env.example .env` and run from the repo root).

# ── Postgres ────────────────────────────────────────────────────────────────
# Single source of truth for the database credentials. The app's DATABASE_URL and
# zero-cache's ZERO_UPSTREAM_DB / ZERO_CVR_DB / ZERO_CHANGE_DB are derived from these
# inside the compose files, so you set them in exactly one place.
POSTGRES_USER=yapm
POSTGRES_PASSWORD=yapm            # CHANGE THIS in production.
POSTGRES_DB=yapm

# ── App container (yapm: API + Zero endpoints + built SPA) ───────────────────
# Host port the app is published on. The app always listens on 3000 inside its network.
YAPM_HOST_PORT=3000
# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# node-postgres pool ceiling for the app.
DATABASE_POOL_MAX=10
# Name of the workspace row seeded on first boot against an empty database.
SEED_WORKSPACE_NAME=yapm
# Seed a demo team + a handful of issues when the first admin signs in on a fresh instance,
# so the issue list has content in dev. One-shot: inert once any team exists. 'true' | 'false'.
SEED_DEMO_CONTENT=false
# Prebuilt image to run instead of building locally, e.g. ghcr.io/<org>/yapm:edge.
# Leave unset to build from docker/Dockerfile on `docker compose up`.
# YAPM_IMAGE=yapm:local

# ── zero-cache ───────────────────────────────────────────────────────────────
# Host port zero-cache is published on. The browser connects DIRECTLY to this
# origin over WebSocket, so it must be reachable from the user's browser.
ZERO_CACHE_HOST_PORT=4848
# Guards the zero-cache inspector and /statz. Required by zero-cache outside
# NODE_ENV=development. CHANGE THIS in production.
ZERO_ADMIN_PASSWORD=change-me-in-production
# Pin a different zero-cache image if needed. Must match the @rocicorp/zero
# catalog version so wire protocol and schema shape agree.
# ZERO_IMAGE=rocicorp/zero:1.8.0
# zero-cache's own log level, independent of the app's LOG_LEVEL above:
# debug | info | warn | error. Raise it to debug while diagnosing a connection that
# will not settle — see the "Sync connection & recovery" self-hosting page.
# ZERO_LOG_LEVEL=info

# ── zero-cache ⇄ app endpoint auth (shared secret, X-Api-Key) ────────────────
# zero-cache sends these to the app's /api/zero/query and /api/zero/mutate; the app
# rejects any request whose header does not match. Both containers read the same
# variable, so they can never disagree. CHANGE THESE in production.
ZERO_QUERY_API_KEY=yapm-zero-query-key-change-me
ZERO_MUTATE_API_KEY=yapm-zero-mutate-key-change-me

# ── Cycle auto-rollover scheduler (pg-boss on the existing Postgres) ──────────
# When active, the app promotes cycles whose start date has passed to "active" and
# completes cycles whose end date has passed — rolling their unfinished issues into the
# next cycle. The same pass opens the retrospective for each cycle it completes and sweeps
# stale retro presence rows, and (when AI is enabled) enqueues the cycle digest. Runs on the
# same Postgres (no extra container). Set to false in tests/e2e for deterministic timing —
# with it off, a cycle completed by hand still rolls over and still opens its retro, since
# both run through the same shared mutators. The cron controls how often the idempotent
# pass runs.
CYCLE_MAINTENANCE=true
CYCLE_MAINTENANCE_CRON=* * * * *

# ── Authentication (better-auth, in-process — adds NO container) ─────────────
# Signing secret for sessions and the Zero sync JWT. CHANGE THIS in production
# (e.g. `openssl rand -base64 32`). An empty .env still boots with the insecure default.
BETTER_AUTH_SECRET=yapm-dev-secret-change-me-in-production
# The browser-facing URL of the app. OAuth callbacks and the sync token's issuer/audience
# use it. Set to your real origin when serving from a domain or a non-3000 host port.
BETTER_AUTH_URL=http://localhost:3000
# The SPA's browser origin, trusted for CORS and better-auth. The two values below are BOTH
# correct — they describe different deployments, which is why the code default and this file
# disagree and neither is a bug:
#   http://localhost:3000  — this compose deploy, where the app serves the built SPA same-origin.
#   http://localhost:5173  — `pnpm dev`, where the SPA is Vite on its own port. That is the Zod
#                            default in apps/server/src/config/env.ts, so an empty .env boots dev.
# This is NOT the variable email links are built from — that is PUBLIC_URL, further down.
WEB_ORIGIN=http://localhost:3000
# GitHub OAuth (all methods are free, none gated). Leave BOTH unset to disable GitHub
# sign-in — an unconfigured provider is simply absent, never paywalled.
# Callback URL to register: ${BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OIDC/SSO is free and enabled; providers are registered at runtime via the SSO plugin,
# so there is no static OIDC env to set here.
# The first authenticated user becomes the workspace admin. Set this to bind that to a
# specific verified email; others then wait for an invite. Leave unset for first-user-wins.
# YAPM_BOOTSTRAP_ADMIN_EMAIL=

# ── Outbound email (optional — two transports, pick one) ─────────────────────
# ALL optional. With NEITHER transport set, email is cleanly OFF: boot never fails, nothing is
# queued, and the in-app notification inbox still works in full. Invite links stay copyable either
# way. Email is only ever a convenience on top.
#
# Pick ONE:
#   SMTP_URL       — an SMTP relay. This one line already reaches Mailgun, Resend, Mailjet,
#                    Postmark, SendGrid and SES: they all issue SMTP credentials.
#   RESEND_API_KEY — Resend over HTTPS. Use this when your host BLOCKS outbound SMTP ports
#                    (many PaaS providers do), where SMTP cannot be made to work at all.
# If both are set, RESEND_API_KEY wins and SMTP_URL is ignored with a warning — never a boot
# failure, because a host blocking SMTP is exactly why the HTTPS sender exists.
#
# Setting either transport makes EMAIL_FROM and PUBLIC_URL required; boot fails naming whichever
# is missing, rather than quietly mailing localhost links to your team.
#
# SMTP_URL must be smtp:// or smtps://, and EMAIL_FROM must contain an address — either one wrong
# fails boot naming the variable, instead of surfacing as an opaque error inside the transport.
# RESEND_API_KEY is an opaque credential with no syntax to check: a wrong key is a logged send
# failure on the first sweep, never a boot failure.
# SMTP_URL=smtp://user:pass@host:587
# RESEND_API_KEY=
# EMAIL_FROM=yapm <notifications@example.com>
# The browsable base URL a human clicks in an email. Distinct from BETTER_AUTH_URL (the origin
# better-auth signs against) and WEB_ORIGIN (the CORS-trusted SPA origin) on purpose.
# PUBLIC_URL=https://yapm.example.com

# ── Notification sweeps (on the existing pg-boss — adds NO container) ────────
# Every *_CRON here (and CYCLE_MAINTENANCE_CRON / GITHUB_RECONCILE_CRON above) is parsed at boot
# with the scheduler's own parser: a value it cannot read fails boot naming the variable, rather
# than booting a healthy-looking instance with the sweep silently unregistered.
# How often unread, unemailed notifications are batched into one email per recipient. Notifications
# already read in the app are never emailed. A 2-minute debounce is applied relative to this cron,
# so lengthening the cron does not need a matching tuning knob.
# NOTIFICATION_EMAIL_CRON=*/2 * * * *
# How long a notification is kept before the retention sweep deletes it, and when that sweep runs.
# Retention runs whether or not email is configured.
# NOTIFICATION_RETENTION_DAYS=30
# NOTIFICATION_RETENTION_CRON=7 3 * * *

# ── Connectors (GitHub App — pull PR/CI/deploy state into the reality strip) ──
# ALL optional. Absent env cleanly DISABLES the GitHub connector (webhook endpoint off, no
# queue/cron); boot never crashes. Distinct from the GitHub OAuth sign-in vars above — this
# is a GitHub App, registered by the operator (see the self-hosting docs). The three
# GITHUB_APP_* vars are all-or-nothing: setting a partial triplet fails boot naming the
# missing variable.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=          # PEM (PKCS#1); \n-escape or base64 the multiline value
# GITHUB_APP_WEBHOOK_SECRET=
# How often the reconcile sweep re-polls GitHub with conditional (ETag/304) requests to heal
# any missed webhook. Only runs when the App is configured. Default: every 15 minutes.
# GITHUB_RECONCILE_CRON=*/15 * * * *
# Master key that encrypts connector secrets at rest (AES-256-GCM). Only needed when secrets
# are entered via the admin UI rather than the env above. REUSED for AI provider keys entered
# via the admin UI. Generate with: openssl rand -base64 32
# Back this up: losing it makes stored secrets unrecoverable.
# SECRETS_ENCRYPTION_KEY=

# ── AI (BYO-key, provider-agnostic gateway — Anthropic / Gemini / OpenAI) ─────
# ALL optional. Absent env cleanly DISABLES AI; boot never crashes. AI is BYO-key and never
# paywalled. Per-workspace keys are normally entered in the admin AI settings UI (encrypted
# with SECRETS_ENCRYPTION_KEY above). The keys below are OPTIONAL instance-defaults for a
# single-instance self-host that prefers env over DB-resident secrets. Model IDs are chosen in
# the UI at runtime (never hardcoded) — prices move, so treat them as runtime config.
# AI_ANTHROPIC_API_KEY=
# AI_GOOGLE_API_KEY=
# AI_OPENAI_API_KEY=
# Which of anthropic | google | openai is the instance default provider. Unset for none.
# AI_DEFAULT_PROVIDER=
# Pre-compute a team-internal cycle digest when a cycle closes (off the hot path, via pg-boss).
# Default: true. Set false to disable the pre-compute job.
# AI_DIGEST_ON_CYCLE_CLOSE=true

# ── Search index (on the existing pg-boss — adds NO container, NO extension) ──
# ALL optional; a fresh instance indexes and searches with none of them set. Full-text search is
# Postgres's own, running in the postgres container you already have — no CREATE EXTENSION of any
# kind (no pg_trgm, no pgvector), because some managed-Postgres hosts cannot grant it. The two
# index passes register on the SAME scheduler as the cycle and notification jobs.
# Index maintenance is deliberately OFF the write path: editing an issue title does no index work,
# so writes stay inside the sub-100ms budget and the index catches up a few seconds behind.
# 'false' stops both index passes. The /api/v1/search route keeps answering from whatever the index
# already holds, and the in-browser pass is unaffected either way.
# SEARCH_INDEX=true
# Seconds between incremental (tail) index passes, 1-3600. pg-boss cron granularity is one minute,
# so the tail worker re-arms itself with this delay; a fixed one-minute cron watchdog heals a broken
# chain and is deliberately NOT tunable.
# SEARCH_INDEX_INTERVAL_SECONDS=10
# When the full reconcile runs: the whole-index diff, the orphan canary, the first-boot backfill,
# and the index-definition check below. It is what heals a row written with a backdated updated_at,
# which the tail's watermark would otherwise miss forever.
# SEARCH_RECONCILE_CRON=*/5 * * * *
# The Postgres text-search configuration used by the index AND every query. 'simple' (the default)
# is language-neutral: no stemming, no stopwords. 'english' ranks English text better at the cost of
# quietly optimising for English teams. Validated for shape at boot and checked against pg_ts_config
# before any DDL; an unknown value fails the reconcile loudly and leaves the old index in place.
# Changing it needs no manual reindex — the reconcile rebuilds that one index when it disagrees.
# SEARCH_TEXT_CONFIG=simple
# Per-request statement_timeout for one search query, 100-60000 ms. A timeout is answered with the
# same status and the same bytes as a miss (a 503 beside a 200 would be an oracle over corpus size),
# and logged server-side WITHOUT the query string — no query is ever recorded anywhere.
# SEARCH_STATEMENT_TIMEOUT_MS=2000

# ── Build-time (baked into the SPA at image build) ───────────────────────────
# The zero-cache origin the browser is told to connect to. Baked into the web bundle
# by Vite at build time, so it must be the browser-reachable URL — not an in-network
# hostname. Change it (and rebuild the image) when serving from a real host/domain,
# e.g. https://zero.example.com.
VITE_ZERO_CACHE_URL=http://localhost:4848

# ── Development loop only (docker/docker-compose.dev.yml + `pnpm dev`) ────────
# Host port the dev Postgres is published on (the host-run server connects here).
POSTGRES_HOST_PORT=5440
